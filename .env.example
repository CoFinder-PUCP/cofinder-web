# URL del backend (cofinder-api)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Base pública de las imágenes.
# Local  → bucket MinIO que levanta docker compose en cofinder-api
# Prod   → dominio público del bucket R2, ej: https://pub-<hash>.r2.dev
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:9000/cofinder-media
